# Copy to deploy/.env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
SERVER_SECRET=change-me-to-another-long-random-string
# The public IP or hostname players connect to for game servers (UDP 7777-7778).
PUBLIC_HOST=203.0.113.10
# Domain for HTTPS (with: docker compose --profile https up -d). Point its DNS at this machine.
DOMAIN=play.example.com
# Image source and version: a git tag that CI published (e.g. v0.1.0), or latest.
IMAGE_PREFIX=ghcr.io/rafidn
VERSION=latest
WORLD=alpha
